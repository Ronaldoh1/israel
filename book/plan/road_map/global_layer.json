  },
  {
   "f": "israel_gov",
   "t": "concert",
   "type": "funding",
   "status": "verified",
   "src": "g_shomrim",
   "label": "2018: 128 million shekels approved for Kela Shlomo (it raised about a fifth of the matching funds); 2022: 25 million shekels a year as \"Concert\"; later \"Voices of Israel\", whose contract the Diaspora Ministry ended in 2024. Its director general: \"this activity has failed by every conceivable parameter.\""
  },
  {
